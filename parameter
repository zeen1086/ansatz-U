# LaNiO2 input template. Review numerical grids and pseudopotentials before any DFT run.
# QE/Wannier preparation only; frozen V1 uses explicit model inputs and an external production JSON.

[paths]
nscf_dir = "/explicit/external/case/5_wannier"
pseudo_dir = "/explicit/external/pseudopotentials"

[model]
nwan = 30
nspin = 1
wan_min = 1
wan_max = 30
convert_size_x = 1
convert_size_y = 1
convert_size_z = 1
a0 = 7.48180367
celldm3 = 0.85231865

[qe]
prefix = "LaNiO2"
export_grid = "smooth"
write_v_qe = true
ecutwfc = 100.0
nr1 = 64
nr2 = 64
nr3 = 64
nk1 = 8
nk2 = 8
nk3 = 8
nbnd = 60
conv_thr = 1e-07
mixing_beta = 0.05
degauss = 0.01
ni_magnetization = 1.0
la_pseudo = "La.upf"
ni_pseudo = "Ni.upf"
o_pseudo = "O.upf"
band_segments = 20

[wannier]
num_bands = 50
first_band = 11
last_band = 60
exclude_bands = "1-10"
dis_froz_min = 6.0
dis_froz_max = 25.0
dis_num_iter = 200
dis_conv_tol = 1e-08
num_iter = 0
